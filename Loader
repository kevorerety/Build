			btnStart.Text = "START BUILD"
			btnStart.TextColor3 = C_GREEN
		end)
	else
		_G.stopautobuild = true
		isBuilding = false
		_G.autobuildRunning = false
		btnStart.Text = "START BUILD"
		btnStart.TextColor3 = C_GREEN
	end
end)

btnCopy.MouseButton1Click:Connect(function()
