	btnCopy.Text = "COPY"
end)

btnClear.MouseButton1Click:Connect(function()
	textBox.Text = ""
	_G.fullBuildString = nil
	_G.buildChunks = nil
	_G.totalChunks = nil
	_G.currentChunk = nil
	btnNextChunk.Visible = false
end)

local saveModeAll = true
btnMode.MouseButton1Click:Connect(function()
	saveModeAll = not saveModeAll
	btnMode.Text = saveModeAll and "MODE: ALL" or "MODE: YOU"
end)

btnSave.MouseButton1Click:Connect(function()
	local bricksFolder = workspace:FindFirstChild("Bricks")
	if not bricksFolder then return end

	local buildString = ""
	local descendants = saveModeAll and bricksFolder:GetDescendants() or (bricksFolder:FindFirstChild(LocalPlayer.Name) and bricksFolder[LocalPlayer.Name]:GetDescendants() or {})

	for _, descendant in pairs(descendants) do
		if descendant:IsA("BasePart") and descendant.Name == "Brick" then
			if not descendant.Anchored then continue end
			local size = descendant.Size
			if size.X % 1 ~= 0 or size.Y % 1 ~= 0 or size.Z % 1 ~= 0 then continue end
			
			local materialSymbol = MaterialSymbols[descendant.Material] or "!"
			local colorHex = string.format("%02X%02X%02X", math.floor(descendant.Color.R * 255), math.floor(descendant.Color.G * 255), math.floor(descendant.Color.B * 255))
			local cf = descendant.CFrame
			local canCollideMarker = descendant.CanCollide and "" or "^"
			
			local sprays = {}
			for _, child in pairs(descendant:GetChildren()) do
				if child.Name == "Spray" and child:FindFirstChild("Label") and FaceSymbols[child.Face] then
					local lbl = child.Label
					local cHex = string.format("%02X%02X%02X", math.floor(lbl.TextColor3.R * 255), math.floor(lbl.TextColor3.G * 255), math.floor(lbl.TextColor3.B * 255))
					table.insert(sprays, string.format('%s"%s""%s"', FaceSymbols[child.Face], lbl.Text or "", cHex))
				end
			end
			local sprayString = #sprays > 0 and "." .. table.concat(sprays, "..") or ""
			buildString = buildString .. string.format("|%s%s%s%.0f,%.0f,%.0f.%.1f,%.1f,%.1f%s.|", colorHex, materialSymbol, canCollideMarker, size.X, size.Y, size.Z, cf.X, cf.Y, cf.Z, sprayString)
		end
	end

	if buildString == "" then return end
	_G.fullBuildString = buildString

	if #buildString <= 190000 then
		textBox.Text = buildString
		setclipboard(buildString)
		btnNextChunk.Visible = false
	else
		local chunks = {}
		for i = 1, #buildString, 190000 do
			table.insert(chunks, buildString:sub(i, i + 190000 - 1))
		end
		_G.buildChunks = chunks
		_G.totalChunks = #chunks
		_G.currentChunk = 1

		setclipboard(chunks[1])
		textBox.Text = "[Build split into " .. #chunks .. " chunks. Chunk 1 copied to clipboard. Click NEXT CHUNK]"
		btnNextChunk.Visible = true
	end
end)

btnNextChunk.MouseButton1Click:Connect(function()
	if not _G.buildChunks or not _G.currentChunk then return end
	_G.currentChunk = math.min(_G.currentChunk + 1, _G.totalChunks)
	setclipboard(_G.buildChunks[_G.currentChunk])
	textBox.Text = "[Chunk " .. _G.currentChunk .. "/" .. _G.totalChunks .. " copied to clipboard!]"
	if _G.currentChunk == _G.totalChunks then
		btnNextChunk.Visible = false
	end
end)

